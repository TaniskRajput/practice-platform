  "status": 200,
  "text": "<div><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title></title>\n<style type=\"text/css\">:root {\n      --bg-dark: #121212;\n      --bg-card: #1e1e1e;\n      --bg-code: #2d2d2d;\n      --primary: #007acc;\n      --primary-hover: #005999;\n      --accent: #4caf50;\n      --accent-hover: #388e3c;\n      --text: #e0e0e0;\n      --text-muted: #aaa;\n      --border: #333;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      background-color: var(--bg-dark);\n      color: var(--text);\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      line-height: 1.5;\n    }\n\n    header {\n      background-color: var(--bg-card);\n      border-bottom: 1px solid var(--border);\n      padding: 1rem 2rem;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      position: sticky;\n      top: 0;\n      z-index: 100;\n    }\n\n    header h1 {\n      font-size: 1.4rem;\n      color: #fff;\n      cursor: pointer;\n    }\n\n    nav {\n      display: flex;\n      gap: 10px;\n    }\n\n    nav button {\n      background-color: var(--bg-code);\n      color: var(--text);\n      border: 1px solid var(--border);\n      padding: 8px 16px;\n      border-radius: 6px;\n      cursor: pointer;\n      font-weight: bold;\n      transition: 0.2s;\n    }\n\n    nav button:hover, nav button.active {\n      background-color: var(--primary);\n      color: white;\n      border-color: var(--primary);\n    }\n\n    .container {\n      max-width: 1200px;\n      margin: 20px auto;\n      padding: 0 20px;\n    }\n\n    .section-card {\n      display: none;\n      background-color: var(--bg-card);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      padding: 24px;\n      margin-bottom: 30px;\n    }\n\n    .section-card.active {\n      display: block;\n    }\n\n    .global-actions {\n      margin-top: 15px;\n      display: flex;\n      gap: 12px;\n    }\n\n    .dashboard-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n      gap: 20px;\n      margin-top: 20px;\n    }\n\n    .dash-card {\n      background: var(--bg-card);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      padding: 24px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      transition: transform 0.2s, border-color 0.2s;\n    }\n\n    .dash-card:hover {\n      transform: translateY(-4px);\n      border-color: var(--primary);\n    }\n\n    .dash-card h3 {\n      color: #fff;\n      margin-bottom: 10px;\n    }\n\n    .dash-card p {\n      color: var(--text-muted);\n      font-size: 0.95rem;\n      margin-bottom: 20px;\n    }\n\n    .status-badge {\n      display: inline-block;\n      background-color: rgba(76, 175, 80, 0.15);\n      color: var(--accent);\n      border: 1px solid var(--accent);\n      padding: 4px 10px;\n      border-radius: 12px;\n      font-size: 0.8rem;\n      font-weight: bold;\n      margin-bottom: 12px;\n      width: fit-content;\n    }\n\n    .section-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-bottom: 1px solid var(--border);\n      padding-bottom: 12px;\n      margin-bottom: 20px;\n    }\n\n    .timer-badge {\n      background-color: #d32f2f;\n      color: white;\n      font-weight: bold;\n      padding: 6px 14px;\n      border-radius: 20px;\n      font-size: 1rem;\n      font-family: monospace;\n    }\n\n    .controls {\n      display: flex;\n      gap: 12px;\n      align-items: center;\n      margin-bottom: 16px;\n      flex-wrap: wrap;\n    }\n\n    select, button.action-btn {\n      background-color: var(--bg-code);\n      color: var(--text);\n      border: 1px solid var(--border);\n      padding: 8px 14px;\n      border-radius: 4px;\n      font-size: 0.95rem;\n      cursor: pointer;\n      transition: background 0.2s;\n    }\n\n    button.action-btn.primary {\n      background-color: var(--primary);\n      color: white;\n      border-color: var(--primary);\n      font-weight: bold;\n    }\n\n    button.action-btn.primary:hover {\n      background-color: var(--primary-hover);\n    }\n\n    button.action-btn.submit {\n      background-color: var(--accent);\n      color: white;\n      border-color: var(--accent);\n      font-weight: bold;\n    }\n\n    button.action-btn.submit:hover {\n      background-color: var(--accent-hover);\n    }\n\n    .editor-container {\n      margin-top: 15px;\n    }\n\n    textarea {\n      width: 100%;\n      min-height: 240px;\n      background-color: var(--bg-code);\n      color: #f8f8f2;\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      padding: 12px;\n      font-family: 'Consolas', 'Courier New', monospace;\n      font-size: 0.95rem;\n      resize: vertical;\n      line-height: 1.4;\n    }\n\n    textarea:focus {\n      outline: 1px solid var(--primary);\n    }\n\n    .solution-box {\n      margin-top: 15px;\n      background-color: #1a271a;\n      border: 1px solid var(--accent);\n      border-radius: 6px;\n      padding: 16px;\n    }\n\n    .solution-box h4 {\n      color: var(--accent);\n      margin-bottom: 8px;\n    }\n\n    .solutions-container {\n      display: flex;\n      flex-direction: column;\n      gap: 20px;\n      margin-top: 15px;\n    }\n\n    pre {\n      background-color: var(--bg-code);\n      padding: 12px;\n      border-radius: 4px;\n      overflow-x: auto;\n      font-family: 'Consolas', 'Courier New', monospace;\n      font-size: 0.9rem;\n      color: #85e89d;\n      white-space: pre-wrap;\n    }\n\n    .test-case-box {\n      background-color: var(--bg-code);\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      padding: 12px 16px;\n      margin-top: 10px;\n    }\n\n    .test-case-box h5 {\n      color: #61afef;\n      margin-bottom: 6px;\n    }\n\n    .schema-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n      gap: 12px;\n      margin: 15px 0;\n    }\n\n    .schema-card {\n      background: var(--bg-code);\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      padding: 10px 14px;\n    }\n\n    .schema-card h5 {\n      color: #61afef;\n      border-bottom: 1px solid var(--border);\n      padding-bottom: 4px;\n      margin-bottom: 6px;\n    }\n\n    .schema-card ul {\n      list-style: none;\n      font-size: 0.85rem;\n      color: var(--text-muted);\n    }\n\n    .preview-box {\n      margin-top: 15px;\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      overflow: hidden;\n      background: #fff;\n    }\n\n    iframe {\n      width: 100%;\n      height: 220px;\n      border: none;\n    }\n</style>\n<script>\n    const templates = {\n      java: {\n        starter: `public class Solution {\\n    public static String encryption(String s) {\\n        // Write your solution here\\n        return \"\";\\n    }\\n}`,\n        solution: `public class Solution {\\n    public static String encryption(String s) {\\n        String str = s.replaceAll(\"\\\\\\\\s+\", \"\");\\n        int L = str.length();\\n        int rows = (int) Math.floor(Math.sqrt(L));\\n        int cols = (int) Math.ceil(Math.sqrt(L));\\n        \\n        if (rows * cols < L) {\\n            rows = cols;\\n        }\\n        \\n        StringBuilder sb = new StringBuilder();\\n        for (int c = 0; c < cols; c++) {\\n            for (int r = 0; r < rows; r++) {\\n                int idx = r * cols + c;\\n                if (idx < L) {\\n                    sb.append(str.charAt(idx));\\n                }\\n            }\\n            if (c < cols - 1) sb.append(\" \");\\n        }\\n        return sb.toString();\\n    }\\n}`\n      },\n      python: {\n        starter: `class Solution:\\n    def encryption(self, s: str) -> str:\\n        # Write your solution here\\n        pass`,\n        solution: `import math\\n\\nclass Solution:\\n    def encryption(self, s: str) -> str:\\n        s = s.replace(\" \", \"\")\\n        L = len(s)\\n        rows = math.floor(math.sqrt(L))\\n        cols = math.ceil(math.sqrt(L))\\n        \\n        if rows * cols < L:\\n            rows = cols\\n            \\n        result = []\\n        for c in range(cols):\\n            word = []\\n            for r in range(rows):\\n                idx = r * cols + c\\n                if idx < L:\\n                    word.append(s[idx])\\n            result.append(\"\".join(word))\\n            \\n        return \" \".join(result)`\n      },\n      csharp: {\n        starter: `public class Solution {\\n    public static string Encryption(string s) {\\n        // Write your solution here\\n        return \"\";\\n    }\\n}`,\n        solution: `using System;\\nusing System.Text;\\n\\npublic class Solution {\\n    public static string Encryption(string s) {\\n        string str = s.Replace(\" \", \"\");\\n        int L = str.Length;\\n        int rows = (int)Math.Floor(Math.Sqrt(L));\\n        int cols = (int)Math.Ceil(Math.Sqrt(L));\\n        \\n        if (rows * cols < L) {\\n            rows = cols;\\n        }\\n        \\n        StringBuilder sb = new StringBuilder();\\n        for (int c = 0; c < cols; c++) {\\n            for (int r = 0; r < rows; r++) {\\n                int idx = r * cols + c;\\n                if (idx < L) {\\n                    sb.Append(str[idx]);\\n                }\\n            }\\n            if (c < cols - 1) sb.Append(\" \");\\n        }\\n        return sb.ToString();\\n    }\\n}`\n      }\n    };\n\n    const timers = {\n      'ds-section': { time: 20 * 60, timerId: 'ds-timer', interval: null },\n      'sql-section': { time: 10 * 60, timerId: 'sql-timer', interval: null },\n      'web-section': { time: 10 * 60, timerId: 'web-timer', interval: null }\n    };\n\n    function startTimer(sectionId) {\n      const timerData = timers[sectionId];\n      if (!timerData || timerData.interval) return;\n\n      timerData.interval = setInterval(() => {\n        if (timerData.time <= 0) {\n          clearInterval(timerData.interval);\n          const el = document.getElementById(timerData.timerId);\n          if (el) el.textContent = \"00:00\";\n          alert(\"Time's up for this section!\");\n          return;\n        }\n        timerData.time--;\n        const m = Math.floor(timerData.time / 60).toString().padStart(2, '0');\n        const s = (timerData.time % 60).toString().padStart(2, '0');\n        const el = document.getElementById(timerData.timerId);\n        if (el) el.textContent = `${m}:${s}`;\n      }, 1000);\n    }\n\n    function showSection(sectionId) {\n      document.querySelectorAll('.section-card').forEach(card => card.classList.remove('active'));\n      document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));\n\n      const targetCard = document.getElementById(sectionId);\n      if (targetCard) {\n        targetCard.classList.add('active');\n      }\n\n      const navBtn = document.getElementById('nav-' + sectionId);\n      if (navBtn) {\n        navBtn.classList.add('active');\n      }\n\n      if (timers[sectionId]) {\n        startTimer(sectionId);\n      }\n\n      if (sectionId === 'web-section') {\n        updateWebPreview();\n      }\n    }\n\n    function changeLanguage() {\n      const select = document.getElementById('langSelect');\n      if (!select) return;\n      const lang = select.value;\n      const editor = document.getElementById('ds-editor');\n      if (editor) editor.value = templates[lang].starter;\n    }\n\n    function changeSolutionLanguage() {\n      const select = document.getElementById('solLangSelect');\n      if (!select) return;\n      const lang = select.value;\n      const solCode = document.getElementById('ds-all-solution-code');\n      if (solCode) solCode.textContent = templates[lang].solution;\n    }\n\n    function submitSection(sectionName) {\n      alert(`Your solution for ${sectionName} has been submitted successfully!`);\n    }\n\n    function updateWebPreview() {\n      const editor = document.getElementById('web-editor');\n      const iframe = document.getElementById('preview-frame');\n      if (!editor || !iframe) return;\n      const doc = iframe.contentDocument || iframe.contentWindow.document;\n      doc.open();\n      doc.write(editor.value);\n      doc.close();\n    }\n\n    window.addEventListener('DOMContentLoaded', () => {\n      changeLanguage();\n      changeSolutionLanguage();\n      showSection('home-section');\n    });\n  </script>\n<header>\n<h1 onclick=\"showSection('home-section')\">Skill Assessment Portal</h1>\n\n<nav><button class=\"nav-btn active\" id=\"nav-home-section\" onclick=\"showSection('home-section')\">Home</button><button class=\"nav-btn\" id=\"nav-ds-section\" onclick=\"showSection('ds-section')\">1. Coding (DSA)</button><button class=\"nav-btn\" id=\"nav-sql-section\" onclick=\"showSection('sql-section')\">2. SQL Database</button><button class=\"nav-btn\" id=\"nav-web-section\" onclick=\"showSection('web-section')\">3. Web Dev</button><button class=\"nav-btn\" id=\"nav-solutions-section\" onclick=\"showSection('solutions-section')\">Solutions</button></nav>\n</header>\n\n<div class=\"container\">\n<div class=\"section-card active\" id=\"home-section\">\n<h2>Assessment Overview</h2>\n\n<p style=\"color: var(--text-muted); margin-top: 5px;\">Select any unlocked section below to begin or manage your assessment tests.</p>\n\n<div class=\"global-actions\"><button class=\"action-btn primary\" onclick=\"showSection('solutions-section')\">View All Solutions</button></div>\n\n<div class=\"dashboard-grid\">\n<div class=\"dash-card\">\n<div><span class=\"status-badge\">Unlocked</span>\n\n<h3>1. Coding (DSA)</h3>\n\n<p>Grid-based Encryption algorithm. Construct layout dimensions and read column-wise.</p>\n</div>\n\n<div>\n<p><strong>Timer:</strong> 20 Mins</p>\n<button class=\"action-btn primary\" onclick=\"showSection('ds-section')\" style=\"width: 100%;\">Start Section</button></div>\n</div>\n\n<div class=\"dash-card\">\n<div><span class=\"status-badge\">Unlocked</span>\n\n<h3>2. SQL Database</h3>\n\n<p>Calculate 30-day retention rate and active subscriber metrics across SaaS billing schemas.</p>\n</div>\n\n<div>\n<p><strong>Timer:</strong> 10 Mins</p>\n<button class=\"action-btn primary\" onclick=\"showSection('sql-section')\" style=\"width: 100%;\">Start Section</button></div>\n</div>\n\n<div class=\"dash-card\">\n<div><span class=\"status-badge\">Unlocked</span>\n\n<h3>3. Web Development</h3>\n\n<p>Implement client-side interactive form validation and dynamic feedback styling.</p>\n</div>\n\n<div>\n<p><strong>Timer:</strong> 10 Mins</p>\n<button class=\"action-btn primary\" onclick=\"showSection('web-section')\" style=\"width: 100%;\">Start Section</button></div>\n</div>\n</div>\n</div>\n\n<div class=\"section-card\" id=\"ds-section\">\n<div class=\"section-header\">\n<h2>Section 1: Data Structures &amp; Algorithms</h2>\n\n<div class=\"timer-badge\" id=\"ds-timer\">20:00</div>\n</div>\n\n<div class=\"question-desc\">\n<h3>Problem Statement: Text Encryption Grid</h3>\n\n<p style=\"margin-top: 6px;\">An English text needs to be encrypted using a grid encryption scheme.</p>\n\n<p style=\"margin-top: 6px;\">First, remove all spaces from the text. Let <code>L</code> be the length of this modified string. Then, arrange the characters in a grid with <code>rows</code> and <code>columns</code> satisfying:</p>\n\n<p style=\"margin-top: 6px; font-family: monospace; color: #61afef; text-align: center;\">floor(√L) ≤ rows ≤ columns ≤ ceil(√L)</p>\n\n<p style=\"margin-top: 6px;\">Ensure that <code>rows × columns ≥ L</code>. If multiple grids satisfy this condition, select the one with the <strong>minimum area</strong> (i.e., <code>rows × columns</code>). Write the encoded message by reading column by column, separating each column with a space.</p>\n\n<h4 style=\"margin-top:15px; color:#61afef;\">Constraints:</h4>\n\n<ul style=\"margin-left:20px; color:var(--text-muted); font-size:0.9rem;\">\n\t<li><code>1 &lt;= length(s) &lt;= 81</code></li>\n\t<li><code>s</code> contains Latin characters and spaces.</li>\n</ul>\n\n<h4 style=\"margin-top:15px; color:#61afef;\">Example Test Cases:</h4>\n\n<div class=\"test-case-box\">\n<h5>Test Case 1</h5>\n\n<p><strong>Input:</strong> <code>s = \"if man was meant to stay on the ground god would have given us roots\"</code></p>\n\n<p><strong>Output:</strong> <code>\"imtha tfaha odmyg erneu gtwru gmsos nneod eveag eerte\"</code></p>\n\n<p style=\"color:var(--text-muted); font-size:0.85rem;\"><strong>Explanation:</strong> After removing spaces, length <code>L = 54</code>. <code>√54</code> is between <code>7</code> and <code>8</code>. So, grid is 7 rows and 8 columns (area = 56 ≥ 54). Reading columns produces 8 words separated by spaces.</p>\n</div>\n\n<div class=\"test-case-box\">\n<h5>Test Case 2</h5>\n\n<p><strong>Input:</strong> <code>s = \"have a nice day\"</code></p>\n\n<p><strong>Output:</strong> <code>\"hae and via ecy\"</code></p>\n\n<p style=\"color:var(--text-muted); font-size:0.85rem;\"><strong>Explanation:</strong> Length <code>L = 12</code> without spaces. <code>√12</code> is between <code>3</code> and <code>4</code>. Dimensions chosen are 3 rows and 4 columns. Grid:<br>\n<code>have</code><br>\n<code>anic</code><br>\n<code>eday</code><br>\nOutput column-wise: <code>\"hae and via ecy\"</code>.</p>\n</div>\n\n<div class=\"test-case-box\">\n<h5>Test Case 3</h5>\n\n<p><strong>Input:</strong> <code>s = \"feedthedog\"</code></p>\n\n<p><strong>Output:</strong> <code>\"fto eeh ddg\"</code></p>\n\n<p style=\"color:var(--text-muted); font-size:0.85rem;\"><strong>Explanation:</strong> <code>L = 10</code>. <code>√10</code> is between 3 and 4. <code>3 × 3 = 9 &lt; 10</code>, so grid dimensions must be <code>3 × 4</code>.</p>\n</div>\n</div>\n\n<div class=\"controls\" style=\"margin-top: 20px;\"><label for=\"langSelect\">Select Language: </label> <select id=\"langSelect\" onchange=\"changeLanguage()\"><option value=\"java\">Java</option><option value=\"python\">Python</option><option value=\"csharp\">C#</option> </select><button class=\"action-btn submit\" onclick=\"submitSection('Section 1: Coding (DSA)')\">Submit Solution</button></div>\n\n<div class=\"editor-container\"><textarea id=\"ds-editor\" spellcheck=\"false\"></textarea></div>\n</div>\n\n<div class=\"section-card\" id=\"sql-section\">\n<div class=\"section-header\">\n<h2>Section 2: Database Querying (SQL)</h2>\n\n<div class=\"timer-badge\" id=\"sql-timer\">10:00</div>\n</div>\n\n<div class=\"question-desc\">\n<h3>Problem Statement: Monthly Subscription Retention Analytics</h3>\n\n<p>Write an SQL query to find the <strong>30-day user renewal rate</strong> per subscription plan for Q1 2026. Calculate total active subscribers, successful renewals, and the renewal percentage formatted as <code>renewal_rate</code> (rounded to 2 decimal places). Filter for plans with more than 50 total subscriptions.</p>\n</div>\n\n<h4 style=\"margin-top:15px; color: #61afef;\">Database Schema (6 Tables)</h4>\n\n<div class=\"schema-grid\">\n<div class=\"schema-card\">\n<h5>Users</h5>\n\n<ul>\n\t<li>user_id (PK)</li>\n\t<li>user_name</li>\n\t<li>signup_date</li>\n</ul>\n</div>\n\n<div class=\"schema-card\">\n<h5>Subscriptions</h5>\n\n<ul>\n\t<li>subscription_id (PK)</li>\n\t<li>user_id (FK)</li>\n\t<li>plan_id (FK)</li>\n\t<li>start_date</li>\n\t<li>end_date</li>\n</ul>\n</div>\n\n<div class=\"schema-card\">\n<h5>Plans</h5>\n\n<ul>\n\t<li>plan_id (PK)</li>\n\t<li>plan_name</li>\n\t<li>monthly_fee</li>\n</ul>\n</div>\n\n<div class=\"schema-card\">\n<h5>Renewals</h5>\n\n<ul>\n\t<li>renewal_id (PK)</li>\n\t<li>subscription_id (FK)</li>\n\t<li>renewal_date</li>\n\t<li>status_id (FK)</li>\n</ul>\n</div>\n\n<div class=\"schema-card\">\n<h5>Payment_Status</h5>\n\n<ul>\n\t<li>status_id (PK)</li>\n\t<li>status_code ('SUCCESS', 'FAILED')</li>\n</ul>\n</div>\n\n<div class=\"schema-card\">\n<h5>Regions</h5>\n\n<ul>\n\t<li>region_id (PK)</li>\n\t<li>region_name</li>\n</ul>\n</div>\n</div>\n\n<div class=\"controls\"><button class=\"action-btn submit\" onclick=\"submitSection('Section 2: SQL Database')\">Submit Solution</button></div>\n\n<div class=\"editor-container\"><textarea id=\"sql-editor\" spellcheck=\"false\">-- Write your SQL Query below:\nSELECT \n    p.plan_name\nFROM Plans p\n-- Add JOINs and analytics logic here\n;</textarea></div>\n</div>\n\n<div class=\"section-card\" id=\"web-section\">\n<div class=\"section-header\">\n<h2>Section 3: Web Development (JS &amp; HTML)</h2>\n\n<div class=\"timer-badge\" id=\"web-timer\">10:00</div>\n</div>\n\n<div class=\"question-desc\">\n<h3>Task: Interactive Password Strength &amp; Match Evaluator</h3>\n\n<p>Modify the provided JavaScript code so that:</p>\n\n<ol style=\"margin-left:20px; margin-top:5px; color: var(--text-muted);\">\n\t<li>Validate that the Password is at least <strong>8 characters</strong> long.</li>\n\t<li>Check that the <strong>Password</strong> and <strong>Confirm Password</strong> fields match in real-time.</li>\n\t<li>Set `#feedback-msg` text to <code>\"Passwords Match\"</code> in green if both pass, or <code>\"Passwords do not match or too short\"</code> in red if validation fails.</li>\n</ol>\n</div>\n\n<div class=\"controls\" style=\"margin-top: 15px;\"><button class=\"action-btn primary\" onclick=\"updateWebPreview()\">Run Code &amp; Update Preview</button><button class=\"action-btn submit\" onclick=\"submitSection('Section 3: Web Development')\">Submit Solution</button></div>\n\n<div class=\"editor-container\"><textarea id=\"web-editor\" spellcheck=\"false\">&lt;!DOCTYPE html&gt;\n&lt;html&gt;\n&lt;head&gt;\n  &lt;style&gt;\n    body { font-family: sans-serif; padding: 15px; color: #333; }\n    .form-group { margin-bottom: 10px; }\n    label { display: block; font-size: 0.85rem; margin-bottom: 4px; }\n    input { padding: 6px; width: 100%; max-width: 280px; }\n    #feedback-msg { font-weight: bold; font-size: 0.85rem; margin-top: 8px; }\n  &lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n  &lt;div class=\"form-group\"&gt;\n    &lt;label for=\"pass\"&gt;Password (Min 8 chars):&lt;/label&gt;\n    &lt;input type=\"password\" id=\"pass\" placeholder=\"Enter password\"&gt;\n  &lt;/div&gt;\n  &lt;div class=\"form-group\"&gt;\n    &lt;label for=\"confirm-pass\"&gt;Confirm Password:&lt;/label&gt;\n    &lt;input type=\"password\" id=\"confirm-pass\" placeholder=\"Confirm password\"&gt;\n  &lt;/div&gt;\n  &lt;p id=\"feedback-msg\"&gt;&lt;/p&gt;\n\n  &lt;script&gt;\n    const passInput = document.getElementById('pass');\n    const confirmInput = document.getElementById('confirm-pass');\n    const msg = document.getElementById('feedback-msg');\n\n    function validate() {\n      // TODO: Implement password validation logic\n    }\n\n    passInput.addEventListener('input', validate);\n    confirmInput.addEventListener('input', validate);\n  &lt;/script&gt;\n&lt;/body&gt;\n&lt;/html&gt;</textarea></div>\n\n<h4 style=\"margin-top: 15px;\">Live Output Preview</h4>\n\n<div class=\"preview-box\"><iframe id=\"preview-frame\"></iframe></div>\n</div>\n\n<div class=\"section-card\" id=\"solutions-section\">\n<div class=\"section-header\">\n<h2>Reference Solutions</h2>\n</div>\n\n<div class=\"solutions-container\">\n<div class=\"solution-box\">\n<div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;\">\n<h4>1. Coding (DSA) Reference Solution</h4>\n\n<div><label for=\"solLangSelect\" style=\"font-size:0.9rem; color: var(--text-muted);\">Language: </label> <select id=\"solLangSelect\" onchange=\"changeSolutionLanguage()\"><option value=\"java\">Java</option><option value=\"python\">Python</option><option value=\"csharp\">C#</option> </select></div>\n</div>\n\n<pre id=\"ds-all-solution-code\"> </pre>\n</div>\n\n<div class=\"solution-box\">\n<h4>2. SQL Database Reference Solution</h4>\n\n<pre>SELECT \n    p.plan_name,\n    COUNT(DISTINCT s.subscription_id) AS total_subscriptions,\n    COUNT(DISTINCT CASE WHEN ps.status_code = 'SUCCESS' THEN r.renewal_id END) AS successful_renewals,\n    ROUND(\n        (COUNT(DISTINCT CASE WHEN ps.status_code = 'SUCCESS' THEN r.renewal_id END) * 100.0) / \n        COUNT(DISTINCT s.subscription_id), 2\n    ) AS renewal_rate\nFROM Plans p\nJOIN Subscriptions s ON p.plan_id = s.plan_id\nLEFT JOIN Renewals r ON s.subscription_id = r.subscription_id\nLEFT JOIN Payment_Status ps ON r.status_id = ps.status_id\nWHERE s.start_date BETWEEN '2026-01-01' AND '2026-03-31'\nGROUP BY p.plan_id, p.plan_name\nHAVING COUNT(DISTINCT s.subscription_id) &gt; 50\nORDER BY renewal_rate DESC;</pre>\n</div>\n\n<div class=\"solution-box\">\n<h4>3. Web Development Reference Solution</h4>\n\n<pre>&lt;script&gt;\n  const passInput = document.getElementById('pass');\n  const confirmInput = document.getElementById('confirm-pass');\n  const msg = document.getElementById('feedback-msg');\n\n  function validate() {\n    const val1 = passInput.value;\n    const val2 = confirmInput.value;\n\n    if (val1.length &gt;= 8 &amp;&amp; val1 === val2) {\n      msg.textContent = \"Passwords Match\";\n      msg.style.color = \"green\";\n    } else {\n      msg.textContent = \"Passwords do not match or too short\";\n      msg.style.color = \"red\";\n    }\n  }\n\n  passInput.addEventListener('input', validate);\n  confirmInput.addEventListener('input', validate);\n&lt;/script&gt;</pre>\n</div>\n</div>\n</div>\n</div>\n</div>"
