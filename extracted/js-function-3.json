  "status": 200,
  "text": "<div><article data-scroll-anchor=\"false\" data-testid=\"conversation-turn-132\" data-turn=\"assistant\" data-turn-id=\"request-6736e3ea-cca0-8006-b359-60ea81a99da6-1\" dir=\"auto\" tabindex=\"-1\">\n<h3 data-end=\"186\" data-start=\"176\"><img height=\"322\" src=\"https://d502jbuhuh9wk.cloudfront.net/articles/68e3e37647d3f776cea946e3/7vb7rb86d.png\" width=\"586\"><br>\n<strong data-end=\"186\" data-start=\"180\">1.</strong></h3>\n\n<pre data-end=\"299\" data-start=\"187\"> </pre>\n\n<p><code>let nums = [1, 2, 3]; </code></p>\n\n<p><code>function addTwo(n)</code></p>\n\n<p><code>{ return n + 2; }</code></p>\n\n<p><code>document.write(nums.map(addTwo)); </code></p>\n\n<p data-end=\"320\" data-start=\"300\"><strong data-end=\"320\" data-start=\"300\">What is printed?</strong></p>\n\n<p data-end=\"378\" data-start=\"322\"><strong data-end=\"334\" data-start=\"322\">Options:</strong><br data-end=\"337\" data-start=\"334\">\nA. 1,2,3<br data-end=\"348\" data-start=\"345\">\nB. 3,4,5<br data-end=\"359\" data-start=\"356\">\nC. 2,3,4<br data-end=\"370\" data-start=\"367\">\nD. NaN</p>\n\n<p data-end=\"399\" data-start=\"380\"><strong data-end=\"391\" data-start=\"380\">Answer:</strong> <strong data-end=\"397\" data-start=\"392\">B</strong></p>\n\n<hr data-end=\"404\" data-start=\"401\">\n<h3 data-end=\"416\" data-start=\"406\"><strong data-end=\"416\" data-start=\"410\">2.</strong></h3>\n\n<pre data-end=\"537\" data-start=\"417\"> </pre>\n\n<p><code>let numbers = [5, 10, 15];</code></p>\n\n<p><code>function double(x)</code></p>\n\n<p><code>{ return x * 2; } </code></p>\n\n<p><code>document.write(numbers.map(double)); </code></p>\n\n<p data-end=\"549\" data-start=\"538\"><strong data-end=\"549\" data-start=\"538\">Output?</strong></p>\n\n<p data-end=\"618\" data-start=\"551\"><strong data-end=\"563\" data-start=\"551\">Options:</strong><br data-end=\"566\" data-start=\"563\">\nA. 10,20,30<br data-end=\"580\" data-start=\"577\">\nB. 5,10,15<br data-end=\"593\" data-start=\"590\">\nC. 2,4,6<br data-end=\"604\" data-start=\"601\">\nD. undefined</p>\n\n<p data-end=\"639\" data-start=\"620\"><strong data-end=\"631\" data-start=\"620\">Answer:</strong> <strong data-end=\"637\" data-start=\"632\">A</strong></p>\n\n<hr data-end=\"644\" data-start=\"641\">\n<h3 data-end=\"656\" data-start=\"646\"><strong data-end=\"656\" data-start=\"650\">3.</strong></h3>\n\n<pre data-end=\"788\" data-start=\"657\"> </pre>\n\n<p><code>let values = [1, 4, 9]; </code></p>\n\n<p><code>function squareRoot(v)</code></p>\n\n<p><code>{ return Math.sqrt(v); }</code></p>\n\n<p><code>document.write(values.map(squareRoot)); </code></p>\n\n<p data-end=\"800\" data-start=\"789\"><strong data-end=\"800\" data-start=\"789\">Output?</strong></p>\n\n<p data-end=\"860\" data-start=\"802\"><strong data-end=\"814\" data-start=\"802\">Options:</strong><br data-end=\"817\" data-start=\"814\">\nA. 1,2,3<br data-end=\"828\" data-start=\"825\">\nB. 1,4,9<br data-end=\"839\" data-start=\"836\">\nC. 2,4,6<br data-end=\"850\" data-start=\"847\">\nD. Error</p>\n\n<p data-end=\"881\" data-start=\"862\"><strong data-end=\"873\" data-start=\"862\">Answer:</strong> <strong data-end=\"879\" data-start=\"874\">A</strong></p>\n\n<hr data-end=\"886\" data-start=\"883\">\n<h3 data-end=\"898\" data-start=\"888\"><strong data-end=\"898\" data-start=\"892\">4.</strong></h3>\n\n<pre data-end=\"1013\" data-start=\"899\"> </pre>\n\n<p><code>let arr = [2, 4, 6]; </code></p>\n\n<p><code>function minusOne(n) { return n - 1; } </code></p>\n\n<p><code>document.write(arr.map(minusOne)); </code></p>\n\n<p data-end=\"1025\" data-start=\"1014\"><strong data-end=\"1025\" data-start=\"1014\">Output?</strong></p>\n\n<p data-end=\"1086\" data-start=\"1027\"><strong data-end=\"1039\" data-start=\"1027\">Options:</strong><br data-end=\"1042\" data-start=\"1039\">\nA. 1,3,5<br data-end=\"1053\" data-start=\"1050\">\nB. 2,4,6<br data-end=\"1064\" data-start=\"1061\">\nC. -1,0,1<br data-end=\"1076\" data-start=\"1073\">\nD. Error</p>\n\n<p data-end=\"1107\" data-start=\"1088\"><strong data-end=\"1099\" data-start=\"1088\">Answer:</strong> <strong data-end=\"1105\" data-start=\"1100\">A</strong></p>\n\n<hr data-end=\"1112\" data-start=\"1109\">\n<h3 data-end=\"1124\" data-start=\"1114\"><strong data-end=\"1124\" data-start=\"1118\">5.</strong></h3>\n\n<pre data-end=\"1223\" data-start=\"1125\"> </pre>\n\n<p><code>let data = [10, 20, 30];</code></p>\n\n<p><code>document.write(data.map(function(e){ return e / 2; })); </code></p>\n\n<p data-end=\"1235\" data-start=\"1224\"><strong data-end=\"1235\" data-start=\"1224\">Output?</strong></p>\n\n<p data-end=\"1301\" data-start=\"1237\"><strong data-end=\"1249\" data-start=\"1237\">Options:</strong><br data-end=\"1252\" data-start=\"1249\">\nA. 5,10,15<br data-end=\"1265\" data-start=\"1262\">\nB. 10,20,30<br data-end=\"1279\" data-start=\"1276\">\nC. 20,40,60<br data-end=\"1293\" data-start=\"1290\">\nD. NaN</p>\n\n<p data-end=\"1322\" data-start=\"1303\"><strong data-end=\"1314\" data-start=\"1303\">Answer:</strong> <strong data-end=\"1320\" data-start=\"1315\">A</strong></p>\n\n<hr data-end=\"1327\" data-start=\"1324\">\n<h3 data-end=\"1339\" data-start=\"1329\"><strong data-end=\"1339\" data-start=\"1333\">6.</strong></h3>\n\n<pre data-end=\"1463\" data-start=\"1340\"> </pre>\n\n<p><code>let numbers = [1,2,3,4]; </code></p>\n\n<p><code>function isEven(n){ return n % 2 === 0; } </code></p>\n\n<p><code>document.write(numbers.map(isEven)); </code></p>\n\n<p data-end=\"1475\" data-start=\"1464\"><strong data-end=\"1475\" data-start=\"1464\">Output?</strong></p>\n\n<p data-end=\"1573\" data-start=\"1477\"><strong data-end=\"1489\" data-start=\"1477\">Options:</strong><br data-end=\"1492\" data-start=\"1489\">\nA. true,false,true,false<br data-end=\"1519\" data-start=\"1516\">\nB. false,true,false,true<br data-end=\"1546\" data-start=\"1543\">\nC. 0,1,0,1<br data-end=\"1559\" data-start=\"1556\">\nD. undefined</p>\n\n<p data-end=\"1594\" data-start=\"1575\"><strong data-end=\"1586\" data-start=\"1575\">Answer:</strong> <strong data-end=\"1592\" data-start=\"1587\">B</strong></p>\n\n<hr data-end=\"1599\" data-start=\"1596\">\n<h3 data-end=\"1611\" data-start=\"1601\"><strong data-end=\"1611\" data-start=\"1605\">7.</strong></h3>\n\n<pre data-end=\"1733\" data-start=\"1612\"> </pre>\n\n<p><code>let arr = [\"a\",\"b\",\"c\"];</code></p>\n\n<p><code>function upper(s){ return s.toUpperCase(); }</code></p>\n\n<p><code>document.write(arr.map(upper)); </code></p>\n\n<p data-end=\"1745\" data-start=\"1734\"><strong data-end=\"1745\" data-start=\"1734\">Output?</strong></p>\n\n<p data-end=\"1809\" data-start=\"1747\"><strong data-end=\"1759\" data-start=\"1747\">Options:</strong><br data-end=\"1762\" data-start=\"1759\">\nA. A,B,C<br data-end=\"1773\" data-start=\"1770\">\nB. a,b,c<br data-end=\"1784\" data-start=\"1781\">\nC. undefined<br data-end=\"1799\" data-start=\"1796\">\nD. Error</p>\n\n<p data-end=\"1830\" data-start=\"1811\"><strong data-end=\"1822\" data-start=\"1811\">Answer:</strong> <strong data-end=\"1828\" data-start=\"1823\">A</strong></p>\n\n<hr data-end=\"1835\" data-start=\"1832\">\n<h3 data-end=\"1847\" data-start=\"1837\"><strong data-end=\"1847\" data-start=\"1841\">8.</strong></h3>\n\n<pre data-end=\"1925\" data-start=\"1848\"> </pre>\n\n<p><code>let nums = [1,2,3,4]; </code></p>\n\n<p><code>document.write(nums.map(n =&gt; n * n)); </code></p>\n\n<p data-end=\"1937\" data-start=\"1926\"><strong data-end=\"1937\" data-start=\"1926\">Output?</strong></p>\n\n<p data-end=\"2008\" data-start=\"1939\"><strong data-end=\"1951\" data-start=\"1939\">Options:</strong><br data-end=\"1954\" data-start=\"1951\">\nA. 1,4,9,16<br data-end=\"1968\" data-start=\"1965\">\nB. 2,4,6,8<br data-end=\"1981\" data-start=\"1978\">\nC. 1,2,3,4<br data-end=\"1994\" data-start=\"1991\">\nD. undefined</p>\n\n<p data-end=\"2029\" data-start=\"2010\"><strong data-end=\"2021\" data-start=\"2010\">Answer:</strong> <strong data-end=\"2027\" data-start=\"2022\">A</strong></p>\n\n<hr data-end=\"2034\" data-start=\"2031\">\n<h3 data-end=\"2046\" data-start=\"2036\"><strong data-end=\"2046\" data-start=\"2040\">9.</strong></h3>\n\n<pre data-end=\"2155\" data-start=\"2047\"> </pre>\n\n<p><code>let arr = [5,10,15];</code></p>\n\n<p><code>function check(x){ return x &gt; 10; } </code></p>\n\n<p><code>document.write(arr.map(check)); </code></p>\n\n<p data-end=\"2167\" data-start=\"2156\"><strong data-end=\"2167\" data-start=\"2156\">Output?</strong></p>\n\n<p data-end=\"2255\" data-start=\"2169\"><strong data-end=\"2181\" data-start=\"2169\">Options:</strong><br data-end=\"2184\" data-start=\"2181\">\nA. false,false,true<br data-end=\"2206\" data-start=\"2203\">\nB. true,false,false<br data-end=\"2228\" data-start=\"2225\">\nC. 5,10,15<br data-end=\"2241\" data-start=\"2238\">\nD. undefined</p>\n\n<p data-end=\"2276\" data-start=\"2257\"><strong data-end=\"2268\" data-start=\"2257\">Answer:</strong> <strong data-end=\"2274\" data-start=\"2269\">A</strong></p>\n\n<hr data-end=\"2281\" data-start=\"2278\">\n<h3 data-end=\"2294\" data-start=\"2283\"><strong data-end=\"2294\" data-start=\"2287\">10.</strong></h3>\n\n<pre data-end=\"2412\" data-start=\"2295\"> </pre>\n\n<p><code>let numbers = [3,6,9]; </code></p>\n\n<p><code>function addFive(n){ return n + 5; }</code></p>\n\n<p><code>document.write(numbers.map(addFive)); </code></p>\n\n<p data-end=\"2424\" data-start=\"2413\"><strong data-end=\"2424\" data-start=\"2413\">Output?</strong></p>\n\n<p data-end=\"2488\" data-start=\"2426\"><strong data-end=\"2438\" data-start=\"2426\">Options:</strong><br data-end=\"2441\" data-start=\"2438\">\nA. 8,11,14<br data-end=\"2454\" data-start=\"2451\">\nB. 5,10,15<br data-end=\"2467\" data-start=\"2464\">\nC. 3,6,9<br data-end=\"2478\" data-start=\"2475\">\nD. Error</p>\n\n<p data-end=\"2509\" data-start=\"2490\"><strong data-end=\"2501\" data-start=\"2490\">Answer:</strong> <strong data-end=\"2507\" data-start=\"2502\">A</strong></p>\n</article>\n\n<article data-scroll-anchor=\"true\" data-testid=\"conversation-turn-134\" data-turn=\"assistant\" data-turn-id=\"request-6736e3ea-cca0-8006-b359-60ea81a99da6-2\" dir=\"auto\" tabindex=\"-1\">\n<hr data-end=\"350\" data-start=\"347\">\n<h3 data-end=\"362\" data-start=\"352\"><strong data-end=\"362\" data-start=\"356\">1.</strong></h3>\n\n<pre data-end=\"579\" data-start=\"363\"> </pre>\n\n<p><code>&lt;button id=\"btn1\" onclick=\"processArray()\"&gt;Click&lt;/button&gt; </code></p>\n\n<p><code>&lt;script&gt; </code></p>\n\n<p><code>let myArray = [2,4,6]; </code></p>\n\n<p><code>function addTen(n){ return n + 10; } </code></p>\n\n<p><code>function processArray(){ document.write(myArray.map(addTen)); </code></p>\n\n<p><code>} &lt;/script&gt; </code></p>\n\n<p data-end=\"629\" data-start=\"580\"><strong data-end=\"627\" data-start=\"580\">What will appear after clicking the button?</strong></p>\n\n<p data-end=\"699\" data-start=\"631\"><strong data-end=\"643\" data-start=\"631\">Options:</strong><br data-end=\"646\" data-start=\"643\">\nA. 12,14,16<br data-end=\"660\" data-start=\"657\">\nB. 2,4,6<br data-end=\"671\" data-start=\"668\">\nC. 10,20,30<br data-end=\"685\" data-start=\"682\">\nD. undefined</p>\n\n<p data-end=\"720\" data-start=\"701\"><strong data-end=\"712\" data-start=\"701\">Answer:</strong> <strong data-end=\"718\" data-start=\"713\">A</strong></p>\n\n<hr data-end=\"725\" data-start=\"722\">\n<h3 data-end=\"737\" data-start=\"727\"><strong data-end=\"737\" data-start=\"731\">2.</strong></h3>\n\n<pre data-end=\"1009\" data-start=\"738\"> </pre>\n\n<p><code>&lt;input type=\"text\" value=\"5,10,15\" id=\"input1\"&gt; </code></p>\n\n<p><code>&lt;button onclick=\"sumValues()\"&gt;Sum&lt;/button&gt; &lt;</code></p>\n\n<p><code>script&gt; </code></p>\n\n<p><code>function sumValues(){ </code></p>\n\n<p><code>let arr = document.getElementById(\"input1\").value.split(\",\");</code></p>\n\n<p><code>document.write(arr.reduce((a,b)=&gt;parseInt(a)+parseInt(b))); </code></p>\n\n<p><code>}</code></p>\n\n<p><code>&lt;/script&gt; </code></p>\n\n<p data-end=\"1046\" data-start=\"1010\"><strong data-end=\"1044\" data-start=\"1010\">Output when button is clicked?</strong></p>\n\n<p data-end=\"1107\" data-start=\"1048\"><strong data-end=\"1060\" data-start=\"1048\">Options:</strong><br data-end=\"1063\" data-start=\"1060\">\nA. 30<br data-end=\"1071\" data-start=\"1068\">\nB. 51015<br data-end=\"1082\" data-start=\"1079\">\nC. undefined<br data-end=\"1097\" data-start=\"1094\">\nD. Error</p>\n\n<p data-end=\"1128\" data-start=\"1109\"><strong data-end=\"1120\" data-start=\"1109\">Answer:</strong> <strong data-end=\"1126\" data-start=\"1121\">A</strong></p>\n\n<hr data-end=\"1133\" data-start=\"1130\">\n<h3 data-end=\"1145\" data-start=\"1135\"><strong data-end=\"1145\" data-start=\"1139\">3.</strong></h3>\n\n<pre data-end=\"1314\" data-start=\"1146\"> </pre>\n\n<p><code>&lt;button onclick=\"checkEven()\"&gt;Check&lt;/button&gt;</code></p>\n\n<p><code>&lt;script&gt; let arr = [1,2,3,4,5];</code></p>\n\n<p><code>function checkEven()</code></p>\n\n<p><code>{ document.write(arr.filter(n =&gt; n%2 === 0)); </code></p>\n\n<p><code>} </code></p>\n\n<p><code>&lt;/script&gt; </code></p>\n\n<p data-end=\"1352\" data-start=\"1315\"><strong data-end=\"1350\" data-start=\"1315\">What is displayed when clicked?</strong></p>\n\n<p data-end=\"1419\" data-start=\"1354\"><strong data-end=\"1366\" data-start=\"1354\">Options:</strong><br data-end=\"1369\" data-start=\"1366\">\nA. 2,4<br data-end=\"1378\" data-start=\"1375\">\nB. 1,3,5<br data-end=\"1389\" data-start=\"1386\">\nC. true,false<br data-end=\"1405\" data-start=\"1402\">\nD. undefined</p>\n\n<p data-end=\"1440\" data-start=\"1421\"><strong data-end=\"1432\" data-start=\"1421\">Answer:</strong> <strong data-end=\"1438\" data-start=\"1433\">A</strong></p>\n\n<hr data-end=\"1445\" data-start=\"1442\">\n<h3 data-end=\"1457\" data-start=\"1447\"><strong data-end=\"1457\" data-start=\"1451\">4.</strong></h3>\n\n<pre data-end=\"1617\" data-start=\"1458\"> </pre>\n\n<p><code>&lt;button onclick=\"showFirst()\"&gt;Show&lt;/button&gt;</code></p>\n\n<p><code>&lt;script&gt; let arr = [5,10,15];</code></p>\n\n<p><code>function showFirst()</code></p>\n\n<p><code>{ document.write(arr.find(n =&gt; n &gt; 7)); </code></p>\n\n<p><code>} </code></p>\n\n<p><code>&lt;/script&gt; </code></p>\n\n<p data-end=\"1640\" data-start=\"1618\"><strong data-end=\"1638\" data-start=\"1618\">Output on click?</strong></p>\n\n<p data-end=\"1694\" data-start=\"1642\"><strong data-end=\"1654\" data-start=\"1642\">Options:</strong><br data-end=\"1657\" data-start=\"1654\">\nA. 5<br data-end=\"1664\" data-start=\"1661\">\nB. 10<br data-end=\"1672\" data-start=\"1669\">\nC. 15<br data-end=\"1680\" data-start=\"1677\">\nD. undefined</p>\n\n<p data-end=\"1715\" data-start=\"1696\"><strong data-end=\"1707\" data-start=\"1696\">Answer:</strong> <strong data-end=\"1713\" data-start=\"1708\">B</strong></p>\n\n<hr data-end=\"1720\" data-start=\"1717\">\n<h3 data-end=\"1732\" data-start=\"1722\"><strong data-end=\"1732\" data-start=\"1726\">5.</strong></h3>\n\n<pre data-end=\"1897\" data-start=\"1733\"> </pre>\n\n<p><code>&lt;button onclick=\"allAboveZero()\"&gt;Test&lt;/button&gt;</code></p>\n\n<p><code>&lt;script&gt; </code></p>\n\n<p><code>let arr = [2,4,6];</code></p>\n\n<p><code>function allAboveZero()</code></p>\n\n<p><code>{ document.write(arr.every(n =&gt; n &gt; 0)); </code></p>\n\n<p><code>}</code></p>\n\n<p><code>&lt;/script&gt; </code></p>\n\n<p data-end=\"1920\" data-start=\"1898\"><strong data-end=\"1918\" data-start=\"1898\">What is printed?</strong></p>\n\n<p data-end=\"1979\" data-start=\"1922\"><strong data-end=\"1934\" data-start=\"1922\">Options:</strong><br data-end=\"1937\" data-start=\"1934\">\nA. true<br data-end=\"1947\" data-start=\"1944\">\nB. false<br data-end=\"1958\" data-start=\"1955\">\nC. 0<br data-end=\"1965\" data-start=\"1962\">\nD. undefined</p>\n\n<p data-end=\"2000\" data-start=\"1981\"><strong data-end=\"1992\" data-start=\"1981\">Answer:</strong> <strong data-end=\"1998\" data-start=\"1993\">A</strong></p>\n\n<hr data-end=\"2005\" data-start=\"2002\">\n<h3 data-end=\"2017\" data-start=\"2007\"><strong data-end=\"2017\" data-start=\"2011\">6.</strong></h3>\n\n<pre data-end=\"2178\" data-start=\"2018\"> </pre>\n\n<p><code>&lt;button onclick=\"someCheck()\"&gt;Click&lt;/button&gt;</code></p>\n\n<p><code>&lt;script&gt; </code></p>\n\n<p><code>let arr = [1,2,3,4]; function someCheck()</code></p>\n\n<p><code>{ document.write(arr.some(n =&gt; n &gt; 3)); </code></p>\n\n<p><code>} </code></p>\n\n<p><code>&lt;/script&gt; </code></p>\n\n<p data-end=\"2192\" data-start=\"2179\"><strong data-end=\"2190\" data-start=\"2179\">Output?</strong></p>\n\n<p data-end=\"2251\" data-start=\"2194\"><strong data-end=\"2206\" data-start=\"2194\">Options:</strong><br data-end=\"2209\" data-start=\"2206\">\nA. true<br data-end=\"2219\" data-start=\"2216\">\nB. false<br data-end=\"2230\" data-start=\"2227\">\nC. 4<br data-end=\"2237\" data-start=\"2234\">\nD. undefined</p>\n\n<p data-end=\"2272\" data-start=\"2253\"><strong data-end=\"2264\" data-start=\"2253\">Answer:</strong> <strong data-end=\"2270\" data-start=\"2265\">A</strong></p>\n\n<hr data-end=\"2277\" data-start=\"2274\">\n<h3 data-end=\"2289\" data-start=\"2279\"><strong data-end=\"2289\" data-start=\"2283\">7.</strong></h3>\n\n<pre data-end=\"2472\" data-start=\"2290\"> </pre>\n\n<p><code>&lt;button onclick=\"doubleValues()\"&gt;Double&lt;/button&gt;</code></p>\n\n<p><code>&lt;script&gt; let arr = [1,2,3]; </code></p>\n\n<p><code>function doubleValues()</code></p>\n\n<p><code>{ arr.forEach((n,i,a)=&gt;a[i]=n*2); </code></p>\n\n<p><code>document.write(arr); }</code></p>\n\n<p><code>&lt;/script&gt; </code></p>\n\n<p data-end=\"2495\" data-start=\"2473\"><strong data-end=\"2493\" data-start=\"2473\">What is printed?</strong></p>\n\n<p data-end=\"2559\" data-start=\"2497\"><strong data-end=\"2509\" data-start=\"2497\">Options:</strong><br data-end=\"2512\" data-start=\"2509\">\nA. 1,2,3<br data-end=\"2523\" data-start=\"2520\">\nB. 2,4,6<br data-end=\"2534\" data-start=\"2531\">\nC. 0,2,4<br data-end=\"2545\" data-start=\"2542\">\nD. undefined</p>\n\n<p data-end=\"2580\" data-start=\"2561\"><strong data-end=\"2572\" data-start=\"2561\">Answer:</strong> <strong data-end=\"2578\" data-start=\"2573\">B</strong></p>\n\n<hr data-end=\"2585\" data-start=\"2582\">\n<h3 data-end=\"2597\" data-start=\"2587\"><strong data-end=\"2597\" data-start=\"2591\">8.</strong></h3>\n\n<pre data-end=\"2777\" data-start=\"2598\"> </pre>\n\n<p><code>&lt;button onclick=\"concatArrays()\"&gt;Concat&lt;/button&gt;</code></p>\n\n<p><code>&lt;script&gt; </code></p>\n\n<p><code>let arr1 = [1,2]; let arr2 = [3,4];</code></p>\n\n<p><code>function concatArrays()</code></p>\n\n<p><code>{ document.write(arr1.concat(arr2)); } </code></p>\n\n<p><code>&lt;/script&gt; </code></p>\n\n<p data-end=\"2791\" data-start=\"2778\"><strong data-end=\"2789\" data-start=\"2778\">Output?</strong></p>\n\n<p data-end=\"2853\" data-start=\"2793\"><strong data-end=\"2805\" data-start=\"2793\">Options:</strong><br data-end=\"2808\" data-start=\"2805\">\nA. 1,2,3,4<br data-end=\"2821\" data-start=\"2818\">\nB. 1,2<br data-end=\"2830\" data-start=\"2827\">\nC. 3,4<br data-end=\"2839\" data-start=\"2836\">\nD. 1,2,[3,4]</p>\n\n<p data-end=\"2874\" data-start=\"2855\"><strong data-end=\"2866\" data-start=\"2855\">Answer:</strong> <strong data-end=\"2872\" data-start=\"2867\">A</strong></p>\n\n<hr data-end=\"2879\" data-start=\"2876\">\n<h3 data-end=\"2891\" data-start=\"2881\"><strong data-end=\"2891\" data-start=\"2885\">9.</strong></h3>\n\n<pre data-end=\"3048\" data-start=\"2892\"> </pre>\n\n<p><code>&lt;button onclick=\"stringify()\"&gt;Show&lt;/button&gt; </code></p>\n\n<p><code>&lt;script&gt; let arr = [1,2,3]; </code></p>\n\n<p><code>function stringify()</code></p>\n\n<p><code>{ document.write(JSON.stringify(arr)); }</code></p>\n\n<p><code>&lt;/script&gt; </code></p>\n\n<p data-end=\"3076\" data-start=\"3049\"><strong data-end=\"3074\" data-start=\"3049\">What will be printed?</strong></p>\n\n<p data-end=\"3142\" data-start=\"3078\"><strong data-end=\"3090\" data-start=\"3078\">Options:</strong><br data-end=\"3093\" data-start=\"3090\">\nA. [1,2,3]<br data-end=\"3106\" data-start=\"3103\">\nB. 1,2,3<br data-end=\"3117\" data-start=\"3114\">\nC. undefined<br data-end=\"3132\" data-start=\"3129\">\nD. Error</p>\n\n<p data-end=\"3163\" data-start=\"3144\"><strong data-end=\"3155\" data-start=\"3144\">Answer:</strong> <strong data-end=\"3161\" data-start=\"3156\">A</strong></p>\n\n<hr data-end=\"3168\" data-start=\"3165\">\n<h3 data-end=\"3181\" data-start=\"3170\"><strong data-end=\"3181\" data-start=\"3174\">10.</strong></h3>\n\n<pre data-end=\"3350\" data-start=\"3182\"> </pre>\n\n<p><code>&lt;button onclick=\"reverseArray()\"&gt;Reverse&lt;/button&gt;</code></p>\n\n<p><code>&lt;script&gt; </code></p>\n\n<p><code>let arr = [5,10,15];</code></p>\n\n<p><code>function reverseArray(){ arr.reverse();</code></p>\n\n<p><code>document.write(arr); } </code></p>\n\n<p><code>&lt;/script&gt; </code></p>\n\n<p data-end=\"3390\" data-start=\"3351\"><strong data-end=\"3388\" data-start=\"3351\">Output after clicking the button?</strong></p>\n\n<p data-end=\"3460\" data-start=\"3392\"><strong data-end=\"3404\" data-start=\"3392\">Options:</strong><br data-end=\"3407\" data-start=\"3404\">\nA. 15,10,5<br data-end=\"3420\" data-start=\"3417\">\nB. 5,10,15<br data-end=\"3433\" data-start=\"3430\">\nC. 10,5,15<br data-end=\"3446\" data-start=\"3443\">\nD. undefined</p>\n\n<p data-end=\"3481\" data-start=\"3462\"><strong data-end=\"3473\" data-start=\"3462\">Answer:</strong> <strong data-end=\"3479\" data-start=\"3474\">A</strong></p>\n</article>\n</div>"
