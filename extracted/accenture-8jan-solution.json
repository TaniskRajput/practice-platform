7%\"><span style=\"font-family:Calibri,sans-serif\">WHERE</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    T3.day = 'wed';</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><br>\n<br>\n<br>\n<img height=\"356\" src=\"https://d502jbuhuh9wk.cloudfront.net/articles/695fbd9ae1ee1c7661cbb924/image-20260108195225-6.png\" width=\"792\"><br>\n<br>\n<br>\n<br>\n<br>\n<br>\n<br>\n<br>\n<br>\n<br>\n<br>\n<br>\n<br>\n<span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\"><b>Assumed HTML Template (Unchanged Structure)</b></span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">&lt;!DOCTYPE html&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">&lt;html&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">&lt;head&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    &lt;title&gt;Dropdown Example&lt;/title&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    &lt;!-- jQuery CDN (must not be removed) --&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    &lt;script src=\"https://code.jquery.com/jquery-3.6.0.min.js\"&gt;&lt;/script&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">&lt;/head&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">&lt;body&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    &lt;div class=\"dropdown container\"&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        &lt;select id=\"fruitDropdown\"&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            &lt;option value=\"\"&gt;Select a fruit&lt;/option&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            &lt;option value=\"Apple\"&gt;Apple&lt;/option&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            &lt;option value=\"Banana\"&gt;Banana&lt;/option&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            &lt;option value=\"Mango\"&gt;Mango&lt;/option&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            &lt;option value=\"Orange\"&gt;Orange&lt;/option&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        &lt;/select&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        &lt;button id=\"showBtn\"&gt;Show Selected&lt;/button&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        &lt;!-- Required paragraph --&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        &lt;p id=\"selectedFruit\"&gt;&lt;/p&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    &lt;/div&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    &lt;script src=\"script.js\"&gt;&lt;/script&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">&lt;/body&gt;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">&lt;/html&gt;</span></span></span></p>\n\n<div align=\"center\" style=\"text-align:center; margin:0cm 0cm 8pt\">\n<hr align=\"center\" size=\"2\" width=\"100%\"></div>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\"><b>JavaScript / jQuery Implementation (script.js)</b></span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">$(document).ready(function () {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    // Center-align text inside the dropdown container</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    $(\".dropdown.container\").css(\"text-align\", \"center\");</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    // Button click event</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    $(\"#showBtn\").click(function () {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        var selectedValue = $(\"#fruitDropdown\").val();</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        $(\"#selectedFruit\").text(selectedValue);</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    });</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">});</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n</div>"
}