\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\"><b>Uniform columns = 0</b></span></span></span></p>\n\n<div align=\"center\" style=\"text-align:center; margin:0cm 0cm 8pt\">\n<hr align=\"center\" size=\"2\" width=\"100%\"></div>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\"><b>Final Answer</b></span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\"><b>Total uniform rows and columns = 1</b></span></span></span></p>\n\n<div align=\"center\" style=\"text-align:center; margin:0cm 0cm 8pt\">\n<hr align=\"center\" size=\"2\" width=\"100%\"></div>\n\n<div align=\"center\" style=\"text-align:center; margin:0cm 0cm 8pt\">\n<hr align=\"center\" size=\"2\" width=\"100%\"></div>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\"><b>Java Solution</b></span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">public class UniformGridCount {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    public static int countUniformRowsAndColumns(String s) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        int len = s.length();</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        int n = (int) Math.sqrt(len);</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        // Build the grid</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        char[][] grid = new char[n][n];</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        int index = 0;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        for (int i = 0; i &lt; n; i++) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            for (int j = 0; j &lt; n; j++) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">                grid[i][j] = s.charAt(index++);</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        int count = 0;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        // Check uniform rows</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        for (int i = 0; i &lt; n; i++) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            boolean isUniform = true;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            for (int j = 1; j &lt; n; j++) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">                if (grid[i][j] != grid[i][0]) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">                    isUniform = false;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">                    break;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">                }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            if (isUniform) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">                count++;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        // Check uniform columns</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        for (int j = 0; j &lt; n; j++) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            boolean isUniform = true;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            for (int i = 1; i &lt; n; i++) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">                if (grid[i][j] != grid[0][j]) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">                    isUniform = false;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">                    break;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">                }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            if (isUniform) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">                count++;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">            }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        return count;</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    public static void main(String[] args) {</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        String s = \"aaaabbbcc\";</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">        System.out.println(countUniformRowsAndColumns(s));</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">    }</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">}</span></span></span></p>\n\n<div align=\"center\" style=\"text-align:center; margin:0cm 0cm 8pt\">\n<hr align=\"center\" size=\"2\" width=\"100%\"></div>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\"><b>Output for</b></span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">S = \"aaaabbbcc\"</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">1</span></span></span><br>\n<br>\n<img height=\"451\" src=\"https://d502jbuhuh9wk.cloudfront.net/articles/695fbd9ae1ee1c7661cbb924/image-20260108195225-4.png\" width=\"802\"></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><img height=\"462\" src=\"https://d502jbuhuh9wk.cloudfront.net/articles/695fbd9ae1ee1c7661cbb924/image-20260108195225-5.png\" width=\"821\"></p>\n\n<p style=\"margin:0cm 0cm 8pt\"> </p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11pt\"><span style=\"line-height:107%\"><span style=\"font-family:Calibri,sans-serif\">SELECT</span></span></span></p>\n\n<p style=\"margin:0cm 0cm 8pt\"><span style=\"font-size:11p