  "text": "<div><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title></title>\n<style type=\"text/css\">:root {\n      --bg-dark: #121212;\n      --bg-card: #1e1e1e;\n      --bg-code: #2d2d2d;\n      --primary: #007acc;\n      --primary-hover: #005999;\n      --accent: #4caf50;\n      --accent-hover: #388e3c;\n      --text: #e0e0e0;\n      --text-muted: #aaa;\n      --border: #333;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      background-color: var(--bg-dark);\n      color: var(--text);\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      line-height: 1.5;\n    }\n\n    header {\n      background-color: var(--bg-card);\n      border-bottom: 1px solid var(--border);\n      padding: 1rem 2rem;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      position: sticky;\n      top: 0;\n      z-index: 100;\n    }\n\n    header h1 {\n      font-size: 1.4rem;\n      color: #fff;\n      cursor: pointer;\n    }\n\n    nav {\n      display: flex;\n      gap: 10px;\n    }\n\n    nav button {\n      background-color: var(--bg-code);\n      color: var(--text);\n      border: 1px solid var(--border);\n      padding: 8px 16px;\n      border-radius: 6px;\n      cursor: pointer;\n      font-weight: bold;\n      transition: 0.2s;\n    }\n\n    nav button:hover, nav button.active {\n      background-color: var(--primary);\n      color: white;\n      border-color: var(--primary);\n    }\n\n    .container {\n      max-width: 1200px;\n      margin: 20px auto;\n      padding: 0 20px;\n    }\n\n    .section-card {\n      display: none;\n      background-color: var(--bg-card);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      padding: 24px;\n      margin-bottom: 30px;\n    }\n\n    .section-card.active {\n      display: block;\n    }\n\n    .global-actions {\n      margin-top: 15px;\n      display: flex;\n      gap: 12px;\n    }\n\n    .dashboard-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n      gap: 20px;\n      margin-top: 20px;\n    }\n\n    .dash-card {\n      background: var(--bg-card);\n      border: 1px solid var(--border);\n      border-radius: 8px;\n      padding: 24px;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      transition: transform 0.2s, border-color 0.2s;\n    }\n\n    .dash-card:hover {\n      transform: translateY(-4px);\n      border-color: var(--primary);\n    }\n\n    .dash-card h3 {\n      color: #fff;\n      margin-bottom: 10px;\n    }\n\n    .dash-card p {\n      color: var(--text-muted);\n      font-size: 0.95rem;\n      margin-bottom: 20px;\n    }\n\n    .status-badge {\n      display: inline-block;\n      background-color: rgba(76, 175, 80, 0.15);\n      color: var(--accent);\n      border: 1px solid var(--accent);\n      padding: 4px 10px;\n      border-radius: 12px;\n      font-size: 0.8rem;\n      font-weight: bold;\n      margin-bottom: 12px;\n      width: fit-content;\n    }\n\n    .section-header {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      border-bottom: 1px solid var(--border);\n      padding-bottom: 12px;\n      margin-bottom: 20px;\n    }\n\n    .timer-badge {\n      background-color: #d32f2f;\n      color: white;\n      font-weight: bold;\n      padding: 6px 14px;\n      border-radius: 20px;\n      font-size: 1rem;\n      font-family: monospace;\n    }\n\n    .controls {\n      display: flex;\n      gap: 12px;\n      align-items: center;\n      margin-bottom: 16px;\n      flex-wrap: wrap;\n    }\n\n    select, button.action-btn {\n      background-color: var(--bg-code);\n      color: var(--text);\n      border: 1px solid var(--border);\n      padding: 8px 14px;\n      border-radius: 4px;\n      font-size: 0.95rem;\n      cursor: pointer;\n      transition: background 0.2s;\n    }\n\n    button.action-btn.primary {\n      background-color: var(--primary);\n      color: white;\n      border-color: var(--primary);\n      font-weight: bold;\n    }\n\n    button.action-btn.primary:hover {\n      background-color: var(--primary-hover);\n    }\n\n    button.action-btn.submit {\n      background-color: var(--accent);\n      color: white;\n      border-color: var(--accent);\n      font-weight: bold;\n    }\n\n    button.action-btn.submit:hover {\n      background-color: var(--accent-hover);\n    }\n\n    .editor-container {\n      margin-top: 15px;\n    }\n\n    textarea {\n      width: 100%;\n      min-height: 240px;\n      background-color: var(--bg-code);\n      color: #f8f8f2;\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      padding: 12px;\n      font-family: 'Consolas', 'Courier New', monospace;\n      font-size: 0.95rem;\n      resize: vertical;\n      line-height: 1.4;\n    }\n\n    textarea:focus {\n      outline: 1px solid var(--primary);\n    }\n\n    .solution-box {\n      margin-top: 15px;\n      background-color: #1a271a;\n      border: 1px solid var(--accent);\n      border-radius: 6px;\n      padding: 16px;\n    }\n\n    .solution-box h4 {\n      color: var(--accent);\n      margin-bottom: 8px;\n    }\n\n    .solutions-container {\n      display: flex;\n      flex-direction: column;\n      gap: 20px;\n      margin-top: 15px;\n    }\n\n    pre {\n      background-color: var(--bg-code);\n      padding: 12px;\n      border-radius: 4px;\n      overflow-x: auto;\n      font-family: 'Consolas', 'Courier New', monospace;\n      font-size: 0.9rem;\n      color: #85e89d;\n      white-space: pre-wrap;\n    }\n\n    .test-case-box {\n      background-color: var(--bg-code);\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      padding: 12px 16px;\n      margin-top: 10px;\n    }\n\n    .test-case-box h5 {\n      color: #61afef;\n      margin-bottom: 6px;\n    }\n\n    .schema-grid {\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n      gap: 12px;\n      margin: 15px 0;\n    }\n\n    .schema-card {\n      background: var(--bg-code);\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      padding: 10px 14px;\n    }\n\n    .schema-card h5 {\n      color: #61afef;\n      border-bottom: 1px solid var(--border);\n      padding-bottom: 4px;\n      margin-bottom: 6px;\n    }\n\n    .schema-card ul {\n      list-style: none;\n      font-size: 0.85rem;\n      color: var(--text-muted);\n    }\n\n    .preview-box {\n      margin-top: 15px;\n      border: 1px solid var(--border);\n      border-radius: 6px;\n      overflow: hidden;\n      background: #fff;\n    }\n\n    iframe {\n      width: 100%;\n      height: 180px;\n      border: none;\n    }\n</style>\n<script>\n    const templates = {\n      java: {\n        starter: `public class Solution {\\n    public boolean checkValid(int[][] matrix) {\\n        // Write your solution here\\n        return false;\\n    }\\n}`,\n        solution: `import java.util.HashSet;\\nimport java.util.Set;\\n\\npublic class Solution {\\n    public boolean checkValid(int[][] matrix) {\\n        int n = matrix.length;\\n        for (int i = 0; i < n; i++) {\\n            Set<Integer> rowSet = new HashSet<>();\\n            Set<Integer> colSet = new HashSet<>();\\n            for (int j = 0; j < n; j++) {\\n                if (!rowSet.add(matrix[i][j])) return false;\\n                if (!colSet.add(matrix[j][i])) return false;\\n            }\\n        }\\n        return true;\\n    }\\n}`\n      },\n      python: {\n        starter: `class Solution:\\n    def checkValid(self, matrix: list[list[int]]) -> bool:\\n        # Write your solution here\\n        pass`,\n        solution: `class Solution:\\n    def checkValid(self, matrix: list[list[int]]) -> bool:\\n        n = len(matrix)\\n        target = set(range(1, n + 1))\\n        for row in matrix:\\n            if set(row) != target:\\n                return False\\n        for col in zip(*matrix):\\n            if set(col) != target:\\n                return False\\n        return True`\n      },\n      csharp: {\n        starter: `public class Solution {\\n    public bool CheckValid(int[][] matrix) {\\n        // Write your solution here\\n        return false;\\n    }\\n}`,\n        solution: `using System.Collections.Generic;\\n\\npublic class Solution {\\n    public bool CheckValid(int[][] matrix) {\\n        int n = matrix.Length;\\n        for (int i = 0; i < n; i++) {\\n            HashSet<int> rowSet = new HashSet<int>();\\n            HashSet<int> colSet = new HashSet<int>();\\n            for (int j = 0; j < n; j++) {\\n                if (!rowSet.Add(matrix[i][j])) return false;\\n                if (!colSet.Add(matrix[j][i])) return false;\\n            }\\n        }\\n        return true;\\n    }\\n}`\n      }\n    };\n\n    const timers = {\n      'ds-section': { time: 20 * 60, timerId: 'ds-timer', interval: null },\n      'sql-section': { time: 10 * 60, timerId: 'sql-timer', interval: null },\n      'web-section': { time: 10 * 60, timerId: 'web-timer', interval: null }\n    };\n\n    function startTimer(sectionId) {\n      const timerData = timers[sectionId];\n      if (!timerData || timerData.interval) return;\n\n      timerData.interval = setInterval(() => {\n        if (timerData.time <= 0) {\n          clearInterval(timerData.interval);\n          const el = document.getElementById(timerData.timerId);\n          if (el) el.textContent = \"00:00\";\n          alert(\"Time's up for this section!\");\n          return;\n        }\n        timerData.time--;\n        const m = Math.floor(timerData.time / 60).toString().padStart(2, '0');\n        const s = (timerData.time % 60).toString().padStart(2, '0');\n        const el = document.getElementById(timerData.timerId);\n        if (el) el.textContent = `${m}:${s}`;\n      }, 1000);\n    }\n\n    function showSection(sectionId) {\n      document.querySelectorAll('.section-card').forEach(card => card.classList.remove('active'));\n      document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));\n\n      const targetCard = document.getElementById(sectionId);\n      if (targetCard) {\n        targetCard.classList.add('active');\n      }\n\n      const navBtn = document.getElementById('nav-' + sectionId);\n      if (navBtn) {\n        navBtn.classList.add('active');\n      }\n\n      if (timers[sectionId]) {\n        startTimer(sectionId);\n      }\n\n      if (sectionId === 'web-section') {\n        updateWebPreview();\n      }\n    }\n\n    function changeLanguage() {\n      const select = document.getElementById('langSelect');\n      if (!select) return;\n      const lang = select.value;\n      const editor = document.getElementById('ds-editor');\n      if (editor) editor.value = templates[lang].starter;\n    }\n\n    function changeSolutionLanguage() {\n      const select = document.getElementById('solLangSelect');\n      if (!select) return;\n      const lang = select.value;\n      const solCode = document.getElementById('ds-all-solution-code');\n      if (solCode) solCode.textContent = templates[lang].solution;\n    }\n\n    function submitSection(sectionName) {\n      alert(`Your solution for ${sectionName} has been submitted successfully!`);\n    }\n\n    function updateWebPreview() {\n      const editor = document.getElementById('web-editor');\n      const iframe = document.getElementById('preview-frame');\n      if (!editor || !iframe) return;\n      const doc = iframe.contentDocument || iframe.contentWindow.document;\n      doc.open();\n      doc.write(editor.value);\n      doc.close();\n    }\n\n    window.addEventListener('DOMContentLoaded', () => {\n      changeLanguage();\n      changeSolutionLanguage();\n      showSection('home-section');\n    });\n  </script>\n<header>\n<h1 onclick=\"showSection('home-section')\">Skill Assessment Portal</h1>\n\n<nav><button class=\"nav-btn active\" id=\"nav-home-section\" onclick=\"showSection('home-section')\">Home</button><button class=\"nav-btn\" id=\"nav-ds-section\" onclick=\"showSection('ds-section')\">1. Coding (DSA)</button><button class=\"nav-btn\" id=\"nav-sql-section\" onclick=\"showSection('sql-section')\">2. SQL Database</button><button class=\"nav-btn\" id=\"nav-web-section\" onclick=\"showSection('web-section')\">3. Web Dev</button><button class=\"nav-btn\" id=\"nav-solutions-section\" onclick=\"showSection('solutions-section')\">Solutions</button></nav>\n</header>\n\n<div class=\"container\">\n<div class=\"section-card active\" id=\"home-section\">\n<h2>Assessment Overview</h2>\n\n<p style=\"color: var(--text-muted); margin-top: 5px;\">Select any unlocked section below to begin or manage your assessment tests.</p>\n\n<div class=\"global-actions\"><button class=\"action-btn primary\" onclick=\"showSection('solutions-section')\">View All Solutions</button></div>\n\n<div class=\"dashboard-grid\">\n<div class=\"dash-card\">\n<div><span class=\"status-badge\">Unlocked</span>\n\n<h3>1. Coding (DSA)</h3>\n\n<p>Check matrix validity (n x n) containing integers 1 to n. Complete test suite provided.</p>\n</div>\n\n<div>\n<p><strong>Timer:</strong> 20 Mins</p>\n<button class=\"action-btn primary\" onclick=\"showSection('ds-section')\" style=\"width: 100%;\">Start Section</button></div>\n</div>\n\n<div class=\"dash-card\">\n<div><span class=\"status-badge\">Unlocked</span>\n\n<h3>2. SQL Database</h3>\n\n<p>Medium complexity SQL query targeting an e-commerce schema across 6 related tables.</p>\n</div>\n\n<div>\n<p><strong>Timer:</strong> 10 Mins</p>\n<button class=\"action-btn primary\" onclick=\"showSection('sql-section')\" style=\"width: 100%;\">Start Section</button></div>\n</div>\n\n<div class=\"dash-card\">\n<div><span class=\"status-badge\">Unlocked</span>\n\n<h3>3. Web Development</h3>\n\n<p>Front-end challenge modifying JavaScript and HTML code for dynamic counter bounds.</p>\n</div>\n\n<div>\n<p><strong>Timer:</strong> 10 Mins</p>\n<button class=\"action-btn primary\" onclick=\"showSection('web-section')\" style=\"width: 100%;\">Start Section</button></div>\n</div>\n</div>\n</div>\n\n<div class=\"section-card\" id=\"ds-section\">\n<div class=\"section-header\">\n<h2>Section 1: Data Structures &amp; Algorithms</h2>\n\n<div class=\"timer-badge\" id=\"ds-timer\">20:00</div>\n</div>\n\n<div class=\"question-desc\">\n<h3>Problem Statement: Check if Matrix Is Valid</h3>\n\n<p style=\"margin-top: 6px;\">An <code>n x n</code> matrix is valid if every row and every column contains <strong>all</strong> the integers from <code>1</code> to <code>n</code> (inclusive).</p>\n\n<p style=\"margin-top: 6px;\">Given an <code>n x n</code> integer matrix <code>matrix</code>, return <code>true</code> if the matrix is valid. Otherwise, return <code>false</code>.</p>\n\n<h4 style=\"margin-top:15px; color:#61afef;\">Constraints:</h4>\n\n<ul style=\"margin-left:20px; color:var(--text-muted); font-size:0.9rem;\">\n\t<li><code>n == matrix.length == matrix[i].length</code></li>\n\t<li><code>1 &lt;= n &lt;= 100</code></li>\n\t<li><code>1 &lt;= matrix[i][j] &lt;= n</code></li>\n</ul>\n\n<h4 style=\"margin-top:15px; color:#61afef;\">Example Test Cases:</h4>\n\n<div class=\"test-case-box\">\n<h5>Test Case 1</h5>\n\n<p><strong>Input:</strong> <code>matrix = [[1,2,3],[3,1,2],[2,3,1]]</code></p>\n\n<p><strong>Output:</strong> <code>true</code></p>\n\n<p style=\"color:var(--text-muted); font-size:0.85rem;\"><strong>Explanation:</strong> In this case, n = 3. Every row and column contains the numbers 1, 2, and 3. Hence, return true.</p>\n</div>\n\n<div class=\"test-case-box\">\n<h5>Test Case 2</h5>\n\n<p><strong>Input:</strong> <code>matrix = [[1,1,1],[1,2,3],[1,2,3]]</code></p>\n\n<p><strong>Output:</strong> <code>false</code></p>\n\n<p style=\"color:var(--text-muted); font-size:0.85rem;\"><strong>Explanation:</strong> In this case, n = 3. The first row [1,1,1] does not contain integers 2 and 3. Hence, return false.</p>\n</div>\n\n<div class=\"test-case-box\">\n<h5>Test Case 3</h5>\n\n<p><strong>Input:</strong> <code>matrix = [[2,2,2],[2,2,2],[2,2,2]]</code></p>\n\n<p><strong>Output:</strong> <code>false</code></p>\n\n<p style=\"color:var(--text-muted); font-size:0.85rem;\"><strong>Explanation:</strong> Duplicate values exist in every row and column, missing integers 1 and 3.</p>\n</div>\n</div>\n\n<div class=\"controls\" style=\"margin-top: 20px;\"><label for=\"langSelect\">Select Language: </label> <select id=\"langSelect\" onchange=\"changeLanguage()\"><option value=\"java\">Java</option><option value=\"python\">Python</option><option value=\"csharp\">C#</option> </select><button class=\"action-btn submit\" onclick=\"submitSection('Section 1: Coding (DSA)')\">Submit Solution</button></div>\n\n<div class=\"editor-container\"><textarea id=\"ds-editor\" spellcheck=\"false\"></textarea></div>\n</div>\n\n<div class=\"section-card\" id=\"sql-section\">\n<div class=\"section-header\">\n<h2>Section 2: Database Querying (SQL)</h2>\n\n<div class=\"timer-badge\" id=\"sql-timer\">10:00</div>\n</div>\n\n<div class=\"question-desc\">\n<h3>Problem Statement: High-Value E-Commerce Customers</h3>\n\n<p>Write an SQL query to retrieve the <code>customer_name</code>, total number of completed orders, and total amount spent for customers who have spent more than <strong>$1,000</strong> in the year 2025 across all completed orders shipped to 'USA'. Sort the results by total amount spent in descending order.</p>\n</div>\n\n<h4 style=\"margin-top:15px; color: #61afef;\">Database Schema (6 Tables)</h4>\n\n<div class=\"schema-grid\">\n<div class=\"schema-card\">\n<h5>Customers</h5>\n\n<ul>\n\t<li>customer_id (PK)</li>\n\t<li>customer_name</li>\n\t<li>country_id (FK)</li>\n</ul>\n</div>\n\n<div class=\"schema-card\">\n<h5>Orders</h5>\n\n<ul>\n\t<li>order_id (PK)</li>\n\t<li>customer_id (FK)</li>\n\t<li>order_date</li>\n\t<li>status_id (FK)</li>\n</ul>\n</div>\n\n<div class=\"schema-card\">\n<h5>Order_Items</h5>\n\n<ul>\n\t<li>item_id (PK)</li>\n\t<li>order_id (FK)</li>\n\t<li>product_id (FK)</li>\n\t<li>quantity</li>\n\t<li>unit_price</li>\n</ul>\n</div>\n\n<div class=\"schema-card\">\n<h5>Products</h5>\n\n<ul>\n\t<li>product_id (PK)</li>\n\t<li>product_name</li>\n\t<li>category_id (FK)</li>\n</ul>\n</div>\n\n<div class=\"schema-card\">\n<h5>Order_Status</h5>\n\n<ul>\n\t<li>status_id (PK)</li>\n\t<li>status_name ('Completed', 'Pending')</li>\n</ul>\n</div>\n\n<div class=\"schema-card\">\n<h5>Countries</h5>\n\n<ul>\n\t<li>country_id (PK)</li>\n\t<li>country_name ('USA', 'Canada')</li>\n</ul>\n</div>\n</div>\n\n<div class=\"controls\"><button class=\"action-btn submit\" onclick=\"submitSection('Section 2: SQL Database')\">Submit Solution</button></div>\n\n<div class=\"editor-container\"><textarea id=\"sql-editor\" spellcheck=\"false\">-- Write your SQL Query below:\nSELECT \n    c.customer_name\nFROM Customers c\n-- Add JOINs and conditions here\n;</textarea></div>\n</div>\n\n<div class=\"section-card\" id=\"web-section\">\n<div class=\"section-header\">\n<h2>Section 3: Web Development (JS &amp; HTML)</h2>\n\n<div class=\"timer-badge\" id=\"web-timer\">10:00</div>\n</div>\n\n<div class=\"question-desc\">\n<h3>Task: Interactive Counter with Limit</h3>\n\n<p>Modify the provided JavaScript code so that:</p>\n\n<ol style=\"margin-left:20px; margin-top:5px; color: var(--text-muted);\">\n\t<li>The <strong>Increment</strong> button increases the count, but cannot exceed <code>10</code>.</li>\n\t<li>The <strong>Decrement</strong> button decreases the count, but cannot go below <code>0</code>.</li>\n\t<li>Update the paragraph with ID <code>status-msg</code> to show \"Maximum limit reached!\" when count is 10, and \"Minimum limit reached!\" when count is 0. Otherwise, keep it empty.</li>\n</ol>\n</div>\n\n<div class=\"controls\" style=\"margin-top: 15px;\"><button class=\"action-btn primary\" onclick=\"updateWebPreview()\">Run Code &amp; Update Preview</button><button class=\"action-btn submit\" onclick=\"submitSection('Section 3: Web Development')\">Submit Solution</button></div>\n\n<div class=\"editor-container\"><textarea id=\"web-editor\" spellcheck=\"false\">&lt;!DOCTYPE html&gt;\n&lt;html&gt;\n&lt;head&gt;\n  &lt;style&gt;\n    body { font-family: sans-serif; text-align: center; padding-top: 10px; }\n    button { padding: 6px 12px; margin: 4px; cursor: pointer; }\n    #count { font-weight: bold; font-size: 1.2rem; }\n    #status-msg { color: red; font-size: 0.85rem; margin-top: 5px; }\n  &lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n  &lt;div&gt;Count: &lt;span id=\"count\"&gt;0&lt;/span&gt;&lt;/div&gt;\n  &lt;button id=\"inc-btn\"&gt;Increment (+)&lt;/button&gt;\n  &lt;button id=\"dec-btn\"&gt;Decrement (-)&lt;/button&gt;\n  &lt;p id=\"status-msg\"&gt;&lt;/p&gt;\n\n  &lt;script&gt;\n    let count = 0;\n    const countEl = document.getElementById('count');\n    const msgEl = document.getElementById('status-msg');\n\n    document.getElementById('inc-btn').addEventListener('click', () =&gt; {\n      // TODO: Increment count (Max limit: 10) and update UI/status\n      count++;\n      countEl.textContent = count;\n    });\n\n    document.getElementById('dec-btn').addEventListener('click', () =&gt; {\n      // TODO: Decrement count (Min limit: 0) and update UI/status\n      count--;\n      countEl.textContent = count;\n    });\n  &lt;/script&gt;\n&lt;/body&gt;\n&lt;/html&gt;</textarea></div>\n\n<h4 style=\"margin-top: 15px;\">Live Output Preview</h4>\n\n<div class=\"preview-box\"><iframe id=\"preview-frame\"></iframe></div>\n</div>\n\n<div class=\"section-card\" id=\"solutions-section\">\n<div class=\"section-header\">\n<h2>Reference Solutions</h2>\n</div>\n\n<div class=\"solutions-container\">\n<div class=\"solution-box\">\n<div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;\">\n<h4>1. Coding (DSA) Reference Solution</h4>\n\n<div><label for=\"solLangSelect\" style=\"font-size:0.9rem; color: var(--text-muted);\">Language: </label> <select id=\"solLangSelect\" onchange=\"changeSolutionLanguage()\"><option value=\"java\">Java</option><option value=\"python\">Python</option><option value=\"csharp\">C#</option> </select></div>\n</div>\n\n<pre id=\"ds-all-solution-code\"> </pre>\n</div>\n\n<div class=\"solution-box\">\n<h4>2. SQL Database Reference Solution</h4>\n\n<pre>SELECT \n    c.customer_name,\n    COUNT(DISTINCT o.order_id) AS total_orders,\n    SUM(oi.quantity * oi.unit_price) AS total_spent\nFROM Customers c\nJOIN Countries cnt ON c.country_id = cnt.country_id\nJOIN Orders o ON c.customer_id = o.customer_id\nJOIN Order_Status os ON o.status_id = os.status_id\nJOIN Order_Items oi ON o.order_id = oi.order_id\nWHERE cnt.country_name = 'USA'\n  AND os.status_name = 'Completed'\n  AND o.order_date BETWEEN '2025-01-01' AND '2025-12-31'\nGROUP BY c.customer_id, c.customer_name\nHAVING SUM(oi.quantity * oi.unit_price) &gt; 1000\nORDER BY total_spent DESC;</pre>\n</div>\n\n<div class=\"solution-box\">\n<h4>3. Web Development Reference Solution</h4>\n\n<pre>&lt;script&gt;\n  let count = 0;\n  const countEl = document.getElementById('count');\n  const msgEl = document.getElementById('status-msg');\n\n  document.getElementById('inc-btn').addEventListener('click', () =&gt; {\n    if (count &lt; 10) {\n      count++;\n      countEl.textContent = count;\n      msgEl.textContent = count === 10 ? \"Maximum limit reached!\" : \"\";\n    }\n  });\n\n  document.getElementById('dec-btn').addEventListener('click', () =&gt; {\n    if (count &gt; 0) {\n      count--;\n      countEl.textContent = count;\n      msgEl.textContent = count === 0 ? \"Minimum limit reached!\" : \"\";\n    }\n  });\n&lt;/script&gt;</pre>\n</div>\n</div>\n</div>\n</div>\n</div>"
}